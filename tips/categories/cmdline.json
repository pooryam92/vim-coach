{
  "tips": [
    {
      "category": [
        "cmdline"
      ],
      "summary": "Tab-complete commands and files",
      "details": [
        ":se<Tab> cycles command names",
        ":e <Tab> cycles matching file names"
      ],
      "mode": "command"
    },
    {
      "category": [
        "cmdline"
      ],
      "summary": "Jump to ends of : Ctrl-b / Ctrl-e",
      "details": [
        "Ctrl-b jumps to the start",
        "Ctrl-e jumps to the end"
      ],
      "advanced": true,
      "mode": "command"
    },
    {
      "category": [
        "cmdline"
      ],
      "summary": "Move by word in : Ctrl-Left",
      "details": [
        "Ctrl-Right hops to the next word",
        "Shift-Left and Shift-Right work too"
      ],
      "advanced": true,
      "mode": "command"
    },
    {
      "category": [
        "cmdline"
      ],
      "summary": "Cancel the : prompt Ctrl-c / Esc",
      "details": [
        "Discards the line you typed",
        "Still saved to : history"
      ],
      "mode": "command"
    },
    {
      "category": [
        "cmdline"
      ],
      "summary": "Erase in : Ctrl-w / Ctrl-u",
      "details": [
        "Ctrl-w deletes a word back",
        "Ctrl-u clears the whole line"
      ],
      "mode": "command"
    },
    {
      "category": [
        "cmdline"
      ],
      "summary": "Recall history by prefix Up / Down",
      "details": [
        "Type :s then Up recalls past :s",
        "Ctrl-p and Ctrl-n ignore the prefix"
      ],
      "mode": "command"
    },
    {
      "category": [
        "cmdline"
      ],
      "summary": "Edit command history with q:",
      "details": [
        "q: opens past commands in a window",
        "Edit a line, press Enter to run it",
        "q/ does the same for searches"
      ],
      "advanced": true
    },
    {
      "category": [
        "cmdline"
      ],
      "summary": "Insert word in : Ctrl-r Ctrl-w",
      "details": [
        "Cursor on foo, type :%s/",
        "Ctrl-r Ctrl-w fills in foo for you"
      ],
      "advanced": true,
      "mode": "command"
    },
    {
      "category": [
        "cmdline"
      ],
      "summary": "Inspect a character with :ascii",
      "details": [
        ":ascii on a shows 97, Hex 61",
        "Unmasks look-alike or hidden chars"
      ],
      "advanced": true
    },
    {
      "category": [
        "cmdline"
      ],
      "summary": "Run a shell command with :!",
      "details": [
        ":!git status shows its output",
        "Runs in the project root"
      ]
    },
    {
      "category": [
        "cmdline"
      ],
      "summary": "Prefill a line range with 3:",
      "details": [
        ":.,.+2 means this line + 2 below",
        "Then type s/a/b/ and press Enter"
      ]
    },
    {
      "category": [
        "cmdline",
        "editing"
      ],
      "summary": "Insert shell output :r! date",
      "details": [
        ":r! date puts the date below you",
        "Try :r! uuidgen for a fresh UUID"
      ]
    },
    {
      "category": [
        "cmdline",
        "ideavim"
      ],
      "summary": "Open the IDE terminal with :sh",
      "details": [
        "Your editor stays open, unlike Vim",
        "Run a quick git or build there"
      ]
    }
  ]
}
