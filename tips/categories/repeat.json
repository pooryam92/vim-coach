{
  "tips": [
    {
      "category": [
        "repeat",
        "editing"
      ],
      "summary": "Repeat last change with .",
      "details": [
        "Replays the last edit at the cursor",
        "Counts work, e.g. 3. repeats 3x"
      ]
    },
    {
      "category": [
        "repeat",
        "editing"
      ],
      "summary": "Add ; to line ends A; then j.",
      "details": [
        "Press A, type ;, press Esc",
        "j. adds it to the next line too",
        "A ignores the column, so . works"
      ]
    },
    {
      "category": [
        "repeat",
        "navigation"
      ],
      "summary": "Space out commas with ;.",
      "details": [
        "f, jumps to a comma",
        "Press a, Space, Esc to add a space",
        "Then ;. ;. does each next comma"
      ]
    },
    {
      "category": [
        "repeat",
        "insert"
      ],
      "summary": "Repeat last insert Ctrl-a / Ctrl-@",
      "details": [
        "Ctrl-a re-types it",
        "Ctrl-@ re-types it, then exits"
      ],
      "advanced": true,
      "mode": "insert"
    },
    {
      "category": [
        "repeat"
      ],
      "summary": "Record a macro qa, replay @a",
      "details": [
        "qa records, do edits, q stops",
        "@a replays it, @@ repeats",
        "10@a replays it ten times"
      ]
    },
    {
      "category": [
        "repeat"
      ],
      "summary": "Append to a macro qA",
      "details": [
        "Uppercase register appends to it",
        "Lowercase q{reg} would replace it"
      ],
      "advanced": true
    },
    {
      "category": [
        "repeat",
        "cmdline"
      ],
      "summary": "Run a macro on lines :normal @r",
      "details": [
        "Select lines with V, then press :",
        "Type normal @r to run r per line"
      ],
      "advanced": true
    },
    {
      "category": [
        "repeat",
        "cmdline"
      ],
      "summary": "Repeat last : command with @:",
      "details": [
        "Run :s/a/b/, go down a line, @:",
        "Then @@ repeats it once more"
      ]
    }
  ]
}
