{
  "tips": [
    {
      "category": [
        "options",
        "navigation"
      ],
      "summary": "Keep lines around cursor scrolloff",
      "details": [
        "Cursor stays 5 lines from the edge",
        "sidescrolloff adds side margin too"
      ],
      "config": [
        "set scrolloff=5"
      ]
    },
    {
      "category": [
        "options"
      ],
      "summary": "Count jumps with relativenumber",
      "details": [
        ":set relativenumber shows the gap",
        "Reads 5j, d3k counts off the gutter",
        "Add number too for a hybrid gutter"
      ],
      "config": {
        "name": "Show relative line numbers",
        "lines": [
          "set relativenumber"
        ]
      }
    },
    {
      "category": [
        "options"
      ],
      "summary": "Show invisible characters with list",
      "details": [
        ":set list reveals spaces and tabs",
        ":set nolist hides them again"
      ],
      "config": [
        "set list"
      ]
    },
    {
      "category": [
        "options",
        "navigation"
      ],
      "summary": "Wrap long lines with wrap",
      "details": [
        ":set wrap soft-wraps long lines",
        "Same as the IDE's soft-wrap toggle"
      ],
      "config": [
        "set wrap"
      ]
    },
    {
      "category": [
        "options",
        "pattern"
      ],
      "summary": "Show matches while typing incsearch",
      "details": [
        "Jumps to the match as you type",
        "Ctrl-g / Ctrl-t hop between matches"
      ],
      "config": [
        "set incsearch"
      ]
    },
    {
      "category": [
        "options",
        "pattern"
      ],
      "summary": "Keep matches highlighted hlsearch",
      "details": [
        "Every match of the search stays lit",
        "Clear temporarily with :noh"
      ],
      "config": [
        "set hlsearch"
      ]
    },
    {
      "category": [
        "options",
        "pattern"
      ],
      "summary": "Smart case search with smartcase",
      "details": [
        "/foo finds foo, Foo and FOO",
        "/Foo finds only Foo"
      ],
      "config": {
        "name": "Enable smart case",
        "lines": [
          "set ignorecase smartcase"
        ]
      }
    },
    {
      "category": [
        "options",
        "pattern"
      ],
      "summary": "Preview :substitute as you type",
      "details": [
        "Type :s/old/new/ and watch it apply",
        "Esc cancels and reverts the preview"
      ],
      "config": {
        "name": "Enable live substitute preview",
        "lines": [
          "set inccommand=nosplit"
        ]
      }
    },
    {
      "category": [
        "options"
      ],
      "summary": "Silence the error beep visualbell",
      "details": [
        "Press k on line 1: it beeps",
        ":set visualbell mutes it right now"
      ],
      "config": {
        "name": "Silence beeps",
        "lines": [
          "set visualbell"
        ]
      }
    }
  ]
}
