{
  "tips": [
    {
      "category": [
        "pattern",
        "repeat"
      ],
      "summary": "Search and hop through matches /",
      "details": [
        "/foo Enter jumps to the next foo",
        "n goes to the next one, N back",
        "? searches backward instead"
      ]
    },
    {
      "category": [
        "pattern",
        "navigation"
      ],
      "summary": "Search word under cursor * and #",
      "details": [
        "* jumps to the next copy of it",
        "# jumps to the previous copy",
        "Whole word only, so foo skips food"
      ]
    },
    {
      "category": [
        "pattern",
        "editing",
        "repeat"
      ],
      "summary": "Rename a word across a file",
      "details": [
        "* picks the word, cgn changes it",
        "Type the new word, press Esc",
        "Then . fixes each next copy"
      ]
    },
    {
      "category": [
        "pattern"
      ],
      "summary": "Override case in a search \\c and \\C",
      "details": [
        "/foo\\c matches Foo FOO foo",
        "/Foo\\C matches only Foo, not foo"
      ],
      "advanced": true
    },
    {
      "category": [
        "pattern"
      ],
      "summary": "Match whole words with \\< and \\>",
      "details": [
        "/ opens a search as usual",
        "Wrap your word: \\<in\\>",
        "/\\<in\\> finds in, not pin or into"
      ],
      "advanced": true
    },
    {
      "category": [
        "pattern",
        "navigation"
      ],
      "summary": "Recenter search results with nzz",
      "details": [
        "n finds the next match, zz centers",
        "Nzz does it the other way"
      ]
    },
    {
      "category": [
        "pattern",
        "editing"
      ],
      "summary": "Delete up to a match d/foo",
      "details": [
        "d/foo Enter deletes up to foo",
        "d/foo/e Enter deletes foo too",
        "d?foo Enter deletes back over foo"
      ]
    },
    {
      "category": [
        "pattern"
      ],
      "summary": "Search text as-is with \\V",
      "details": [
        "/ opens a search as usual",
        "Add \\V to drop all regex",
        "/\\Va.b finds a.b, not aXb"
      ],
      "advanced": true
    },
    {
      "category": [
        "pattern"
      ],
      "summary": "Search with full regex \\v",
      "details": [
        "/\\v(foo|bar) finds foo or bar",
        "Plain / needs \\(foo\\|bar\\)"
      ],
      "advanced": true
    },
    {
      "category": [
        "pattern",
        "cmdline"
      ],
      "summary": "Replace every match with :%s",
      "details": [
        ":%s/foo/bar/g turns foo into bar",
        "% is the whole file, g every match"
      ]
    },
    {
      "category": [
        "pattern",
        "cmdline"
      ],
      "summary": "Count matches with :%s/foo//n",
      "details": [
        "Reports 3 matches on 2 lines",
        "n counts only, text is untouched",
        "The empty replacement is ignored"
      ],
      "advanced": true
    },
    {
      "category": [
        "pattern",
        "cmdline"
      ],
      "summary": "Reuse last / pattern in :s with //",
      "details": [
        "Search /foo, then :%s//bar/g",
        "The empty pattern reuses foo",
        "Ctrl-r / pastes foo to edit it"
      ],
      "advanced": true
    },
    {
      "category": [
        "pattern",
        "cmdline"
      ],
      "summary": "Confirm each :s replace with gc",
      "details": [
        ":%s/foo/bar/gc stops at each foo",
        "y replaces it, n skips it",
        "a replaces all, q quits"
      ],
      "advanced": true
    },
    {
      "category": [
        "pattern",
        "repeat"
      ],
      "summary": "Repeat last :s with & and g&",
      "details": [
        ":s/foo/bar/ changes one line",
        "& reruns it on the line you're on",
        "g& reruns it across the whole file"
      ],
      "advanced": true
    },
    {
      "category": [
        "pattern",
        "cmdline"
      ],
      "summary": "Reuse the match in :s with &",
      "details": [
        ":%s/cat/&s/g turns cat into cats",
        "& stands for whatever matched"
      ],
      "advanced": true
    },
    {
      "category": [
        "pattern",
        "cmdline",
        "visual"
      ],
      "summary": "Limit :s to a range",
      "details": [
        ":10,20s/a/b/g edits lines 10 to 20",
        "Or select lines first, then :s"
      ],
      "advanced": true
    },
    {
      "category": [
        "pattern",
        "cmdline"
      ],
      "summary": "Act on matching lines with :g",
      "details": [
        ":g/TODO/d deletes every TODO line",
        ":g/TODO/s/a/b/ edits just those"
      ],
      "advanced": true
    },
    {
      "category": [
        "pattern",
        "cmdline"
      ],
      "summary": "Keep only matching lines :v/foo/d",
      "details": [
        ":v/foo/d deletes lines lacking foo",
        "What's left: only the foo lines"
      ],
      "advanced": true
    }
  ]
}
