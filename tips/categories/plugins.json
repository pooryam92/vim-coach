{
  "tips": [
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Edit every copy of a word Ctrl-n",
      "details": [
        "Put the cursor on foo, press Ctrl-n",
        "Ctrl-n adds next foo, Ctrl-x skips",
        "Then c, type bar, Esc — all to bar"
      ],
      "config": {
        "name": "Install multiple-cursors",
        "lines": [
          "Plug 'terryma/vim-multiple-cursors'",
          "nmap <C-n> <Plug>NextWholeOccurrence",
          "xmap <C-n> <Plug>NextWholeOccurrence",
          "xmap <C-x> <Plug>SkipOccurrence"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Grab all copies at once Alt-n",
      "details": [
        "Alt-n on foo selects every foo",
        "Then c, type bar, Esc — all to bar"
      ],
      "config": {
        "name": "Install multiple-cursors",
        "lines": [
          "Plug 'terryma/vim-multiple-cursors'",
          "nmap <A-n> <Plug>AllWholeOccurrences"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Add surroundings ysiw)",
      "details": [
        "ysiw) turns word into (word)",
        "ysiw( gives ( word ), with spaces",
        "Takes any motion, like ysip)"
      ],
      "config": {
        "name": "Install vim-surround",
        "lines": [
          "Plug 'tpope/vim-surround'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "yss) wraps the whole line",
      "details": [
        "yss) surrounds the line with ( )",
        "Any non-letter works, like yss*"
      ],
      "config": {
        "name": "Install vim-surround",
        "lines": [
          "Plug 'tpope/vim-surround'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Change surroundings cs\"'",
      "details": [
        "cs\"' turns \"hi\" into 'hi'",
        "cs)] turns (x) into [x]",
        "Move to the next one, . repeats it"
      ],
      "config": {
        "name": "Install vim-surround",
        "lines": [
          "Plug 'tpope/vim-surround'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Delete surroundings ds\"",
      "details": [
        "ds\" turns \"hi\" into hi",
        "ds( strips parens the same way"
      ],
      "config": {
        "name": "Install vim-surround",
        "lines": [
          "Plug 'tpope/vim-surround'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "visual"
      ],
      "summary": "Surround a visual selection S",
      "details": [
        "Press S then a bracket or tag",
        "S) wraps in ( ), S<em> in <em> tags"
      ],
      "config": {
        "name": "Install vim-surround",
        "lines": [
          "Plug 'tpope/vim-surround'"
        ]
      },
      "mode": "visual"
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Wrap in an HTML tag ysiwt",
      "details": [
        "ysiwt prompts for a tag name",
        "Type em, Enter — <em>word</em>"
      ],
      "config": {
        "name": "Install vim-surround",
        "lines": [
          "Plug 'tpope/vim-surround'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Rename an HTML tag cst",
      "details": [
        "cst<div> makes <span> into <div>",
        "Edits both open and close tags"
      ],
      "config": {
        "name": "Install vim-surround",
        "lines": [
          "Plug 'tpope/vim-surround'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Delete an HTML tag dst",
      "details": [
        "dst turns <span>hi</span> into hi",
        "Strips both tags, keeps the text"
      ],
      "config": {
        "name": "Install vim-surround",
        "lines": [
          "Plug 'tpope/vim-surround'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Wrap in a function call ysiwf",
      "details": [
        "ysiwf asks for a function name",
        "Type print, Enter — print(word)"
      ],
      "config": {
        "name": "Install vim-surround",
        "lines": [
          "Plug 'tpope/vim-surround'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Toggle comments gcc / gcip",
      "details": [
        "gcc toggles the line you're on",
        "gcip does the whole paragraph",
        "Or select lines, then press gc"
      ],
      "config": {
        "name": "Install vim-commentary",
        "lines": [
          "Plug 'tpope/vim-commentary'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Uncomment a whole block gcu",
      "details": [
        "Cursor on any commented-out line",
        "Every line in it is uncommented"
      ],
      "config": {
        "name": "Install vim-commentary",
        "lines": [
          "Plug 'tpope/vim-commentary'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Comment out one word gciw",
      "details": [
        "Uses a block comment, like /* */",
        "Takes any motion, like gci("
      ],
      "config": {
        "name": "Install vim-commentary",
        "lines": [
          "Plug 'tpope/vim-commentary'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Delete a comment block dgc",
      "details": [
        "Cursor anywhere in the comment",
        "All its lines go, /** */ docs too"
      ],
      "config": {
        "name": "Install vim-commentary",
        "lines": [
          "Plug 'tpope/vim-commentary'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "registers"
      ],
      "summary": "Flash text after you yank it",
      "details": [
        "Try yip — the paragraph flashes",
        "Confirms exactly what was copied"
      ],
      "config": {
        "name": "Install vim-highlightedyank",
        "lines": [
          "Plug 'machakann/vim-highlightedyank'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "registers"
      ],
      "summary": "Paste over a word, keep yank griw",
      "details": [
        "yiw copies a word, griw pastes it",
        "Yank survives, repeat it anywhere",
        "Any motion works, e.g. grr a line"
      ],
      "config": {
        "name": "Install ReplaceWithRegister",
        "lines": [
          "Plug 'vim-scripts/ReplaceWithRegister'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Swap two regions cxiw",
      "details": [
        "cxiw on foo, then cxiw on bar",
        "foo and bar trade places"
      ],
      "config": {
        "name": "Install vim-exchange",
        "lines": [
          "Plug 'tommcdo/vim-exchange'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Act on an argument cia / caa",
      "details": [
        "cia changes just the argument",
        "caa takes the trailing comma too",
        "Pairs with any operator — d, y"
      ],
      "config": {
        "name": "Install argtextobj",
        "lines": [
          "Plug 'vim-scripts/argtextobj.vim'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Act on a block by indent dii",
      "details": [
        "dii deletes lines at this indent",
        "dai adds the header line above",
        "daI adds the closing line below too"
      ],
      "config": {
        "name": "Install vim-indent-object",
        "lines": [
          "Plug 'michaeljsmith/vim-indent-object'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "pattern"
      ],
      "summary": "Substitute case variants with :S",
      "details": [
        ":S/foo/bar/g replaces all casings",
        "foo→bar, Foo→Bar, FOO→BAR"
      ],
      "config": {
        "name": "Install vim-abolish",
        "lines": [
          "Plug 'tpope/vim-abolish'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Recase a word to camelCase crc",
      "details": [
        "crc turns foo_bar into fooBar",
        "crs goes back, crm makes FooBar",
        "Cursor can sit anywhere in the word"
      ],
      "config": {
        "name": "Install vim-abolish",
        "lines": [
          "Plug 'tpope/vim-abolish'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Edit the next () pair cin)",
      "details": [
        "Works with the cursor outside it",
        "cil) targets the previous pair",
        "Any bracket or quote works too"
      ],
      "config": {
        "name": "Install targets.vim",
        "lines": [
          "Plug 'wellle/targets.vim'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Delete a comma item da, / di,",
      "details": [
        "da, takes the item and a comma",
        "di, keeps the commas in place",
        "Any separator works, e.g. ; or |"
      ],
      "config": {
        "name": "Install targets.vim",
        "lines": [
          "Plug 'wellle/targets.vim'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Copy the whole file yae",
      "details": [
        "dae empties it, =ae reindents it",
        "vae selects it, no gg needed"
      ],
      "config": {
        "name": "Install vim-textobj-entire",
        "lines": [
          "Plug 'kana/vim-textobj-entire'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Yank a line minus indent yil",
      "details": [
        "Skips indent and the line break",
        "p then pastes it inline, not below"
      ],
      "config": {
        "name": "Install vim-textobj-line",
        "lines": [
          "Plug 'kana/vim-textobj-line'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "navigation"
      ],
      "summary": "Jump to two chars s / S",
      "details": [
        "sfo jumps forward to fo",
        "Sfo searches backward"
      ],
      "config": {
        "name": "Install vim-sneak",
        "lines": [
          "Plug 'justinmk/vim-sneak'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "navigation"
      ],
      "summary": "Match tags and blocks %",
      "details": [
        "% jumps across HTML/XML tag pairs",
        "Also matches if/end style blocks"
      ],
      "config": {
        "name": "Install matchit",
        "lines": [
          "Plug 'chrisbra/matchit'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "navigation"
      ],
      "summary": "Stop { and } on whitespace lines",
      "details": [
        "Plain { and } skip space-only lines",
        "Blank lines often keep stray indent"
      ],
      "config": {
        "name": "Install vim-paragraph-motion",
        "lines": [
          "Plug 'dbakker/vim-paragraph-motion'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "files"
      ],
      "summary": "Open a file tree :NERDTreeToggle",
      "details": [
        "In the tree, j / k move, o opens",
        ":NERDTreeFind shows this file there"
      ],
      "config": {
        "name": "Install NERDTree",
        "lines": [
          "Plug 'preservim/nerdtree'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Act on a method dam / dim",
      "details": [
        "dam deletes the whole method",
        "dim deletes just the body"
      ],
      "config": {
        "name": "Install vim-textobj-function",
        "lines": [
          "Plug 'kana/vim-textobj-function'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Act on a whole class dac",
      "details": [
        "dac deletes it from anywhere inside",
        "yac copies it, vac selects it"
      ],
      "config": {
        "name": "Enable classtextobj",
        "lines": [
          "set classtextobj"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "insert"
      ],
      "summary": "Tab through IDE completions",
      "details": [
        "Tab moves down the popup list",
        "Shift-Tab moves up, Enter accepts",
        "No popup open? Tab still indents"
      ],
      "config": {
        "name": "Enable youcompleteme",
        "lines": [
          "set youcompleteme"
        ]
      },
      "mode": "insert"
    },
    {
      "category": [
        "plugins",
        "navigation"
      ],
      "summary": "Hop to same-indent lines ]= and [=",
      "details": [
        "]= to the next line at this indent",
        "[= to the previous one"
      ],
      "config": {
        "name": "Install indentwise",
        "lines": [
          "Plug 'jeetsukumaran/vim-indentwise'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "navigation"
      ],
      "summary": "Step in or out by indent ]+ and ]-",
      "details": [
        "]+ to the next more-indented line",
        "]- to the next less-indented line"
      ],
      "config": {
        "name": "Install indentwise",
        "lines": [
          "Plug 'jeetsukumaran/vim-indentwise'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "editing"
      ],
      "summary": "Change inside any pair cib / ciq",
      "details": [
        "cib changes in the nearest bracket",
        "ciq does the same for quotes"
      ],
      "config": {
        "name": "Enable mini-ai",
        "lines": [
          "set mini-ai"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "registers"
      ],
      "summary": "Paste an older yank p Ctrl-p",
      "details": [
        "Ctrl-p works right after a paste",
        "Keep pressing back, Ctrl-n forward",
        "Both stop being k and j in Normal"
      ],
      "config": {
        "name": "Install YankRing",
        "lines": [
          "Plug 'vim-scripts/YankRing.vim'"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "pattern"
      ],
      "summary": "Search for the selected text *",
      "details": [
        "Finds arr[0] as typed, no escaping",
        "# searches backward, n repeats"
      ],
      "config": {
        "name": "Install visual-star-search",
        "lines": [
          "Plug 'bronson/vim-visual-star-search'"
        ]
      },
      "mode": "visual"
    },
    {
      "category": [
        "plugins",
        "ideavim"
      ],
      "summary": "Click the UI by keys Ctrl-Shift-\\",
      "details": [
        "Labels cover buttons, tabs, fields",
        "Type a label's letters to click it",
        "On macOS press Ctrl-Cmd-\\ instead"
      ],
      "config": {
        "name": "Enable VimEverywhere",
        "lines": [
          "set VimEverywhere"
        ]
      }
    },
    {
      "category": [
        "plugins",
        "windows"
      ],
      "summary": "Hop into tool windows Ctrl-w h",
      "details": [
        "Ctrl-w h enters the Project panel",
        "Ctrl-w l comes back to the editor",
        "Ctrl-w j reaches a bottom panel"
      ],
      "config": {
        "name": "Enable VimEverywhere",
        "lines": [
          "set VimEverywhere"
        ]
      }
    }
  ]
}
