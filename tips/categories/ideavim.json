{
  "tips": [
    {
      "category": [
        "ideavim",
        "options",
        "registers"
      ],
      "summary": "Yank to the OS clipboard by default",
      "details": [
        "y and p now use the OS clipboard",
        "Copy in a browser, p pastes it"
      ],
      "config": {
        "name": "Enable OS clipboard",
        "lines": [
          "set clipboard+=unnamedplus",
          "set clipboard+=ideaput"
        ]
      }
    },
    {
      "category": [
        "ideavim",
        "cmdline"
      ],
      "summary": "Reload ~/.ideavimrc with :source",
      "details": [
        ":e ~/.ideavimrc opens it to edit",
        ":source ~/.ideavimrc reloads it",
        "No IDE restart needed"
      ]
    },
    {
      "category": [
        "ideavim",
        "files"
      ],
      "summary": "Open ~/.ideavimrc in two clicks",
      "details": [
        "Click Vim's icon in the status bar",
        "Pick Open ~/.ideavimrc to edit it",
        "No file yet? Pick Create instead"
      ]
    },
    {
      "category": [
        "ideavim",
        "options"
      ],
      "summary": "Test options live with :set",
      "details": [
        ":set nonumber hides line numbers",
        ":set invnumber flips them back",
        "Add to .ideavimrc to keep it"
      ]
    },
    {
      "category": [
        "ideavim",
        "cmdline"
      ],
      "summary": "Run any IDE action with :action",
      "details": [
        ":action ReformatCode reformats now",
        ":actionlist format finds more IDs"
      ]
    },
    {
      "category": [
        "ideavim",
        "options",
        "mappings"
      ],
      "summary": "Show action IDs with trackactionids",
      "details": [
        "Run any IDE action: its ID pops up",
        "Paste it into <Action>(ID) maps"
      ],
      "config": {
        "name": "Enable trackactionids",
        "lines": [
          "set trackactionids"
        ]
      }
    },
    {
      "category": [
        "ideavim",
        "mappings"
      ],
      "summary": "Hand a Ctrl key back to the IDE",
      "details": [
        "Settings | Editor | Vim lists them",
        "Pick IDE or Vim for each Ctrl key",
        ".ideavimrc: sethandler <C-f> a:ide"
      ]
    },
    {
      "category": [
        "ideavim",
        "options",
        "editing"
      ],
      "summary": "Smarter J join with ideajoin",
      "details": [
        "J on two // lines keeps one //",
        "Nested ifs join into if (a && b)"
      ],
      "config": {
        "name": "Enable ideajoin",
        "lines": [
          "set ideajoin"
        ]
      }
    },
    {
      "category": [
        "ideavim",
        "options"
      ],
      "summary": "Keep Vim mode during rename",
      "details": [
        "Rename won't force Select mode",
        "From Normal, edit the name with ciw"
      ],
      "config": {
        "name": "Keep mode on rename",
        "lines": [
          "set idearefactormode=keep"
        ]
      }
    },
    {
      "category": [
        "ideavim"
      ],
      "summary": "Open quick docs with K",
      "details": [
        "On a method call, K shows its docs",
        "Params and return type, no hover"
      ]
    },
    {
      "category": [
        "ideavim",
        "navigation"
      ],
      "summary": "Jump between errors ]e / [e",
      "details": [
        "Stops on warnings too",
        "Then Alt-Enter offers a quick fix"
      ],
      "config": {
        "name": "Map errors",
        "lines": [
          "nmap ]e <Action>(GotoNextError)",
          "nmap [e <Action>(GotoPreviousError)"
        ]
      }
    },
    {
      "category": [
        "ideavim"
      ],
      "summary": "Show error details with Ctrl-k",
      "details": [
        "Pops up the error at the cursor",
        "Warnings too, no mouse hover needed"
      ],
      "config": {
        "name": "Map error popup",
        "lines": [
          "nmap <C-k> <Action>(ShowErrorDescription)"
        ]
      }
    },
    {
      "category": [
        "ideavim",
        "navigation"
      ],
      "summary": "Jump between git changes ]c / [c",
      "details": [
        "Moves between uncommitted hunks",
        "Gutter marks vs the last commit"
      ],
      "config": {
        "name": "Map VCS changes",
        "lines": [
          "nmap ]c <Action>(VcsShowNextChangeMarker)",
          "nmap [c <Action>(VcsShowPrevChangeMarker)"
        ]
      }
    },
    {
      "category": [
        "ideavim",
        "editing"
      ],
      "summary": "Open the quick-fix menu ga",
      "details": [
        "Same popup as Alt-Enter's lightbulb",
        "Replaces ga, which shows char codes"
      ],
      "config": {
        "name": "Map quick-fix",
        "lines": [
          "nmap ga <Action>(ShowIntentionActions)"
        ]
      }
    },
    {
      "category": [
        "ideavim",
        "editing"
      ],
      "summary": "Rename a symbol everywhere gR",
      "details": [
        "Type the new name right in place",
        "Same as Shift-F6, no chord needed"
      ],
      "config": {
        "name": "Map rename",
        "lines": [
          "nmap gR <Action>(RenameElement)"
        ]
      }
    },
    {
      "category": [
        "ideavim",
        "editing"
      ],
      "summary": "Open the refactor menu gm",
      "details": [
        "Extract, inline, move in one list",
        "Replaces gm, the mid-line jump"
      ],
      "config": {
        "name": "Map refactor",
        "lines": [
          "nmap gm <Action>(Refactorings.QuickListPopupAction)"
        ]
      }
    },
    {
      "category": [
        "ideavim",
        "editing"
      ],
      "summary": "Move a line down/up Alt-j / Alt-k",
      "details": [
        "Tap again to nudge it further",
        "Select lines first to move a block"
      ],
      "config": {
        "name": "Map line moves",
        "lines": [
          "nmap <A-j> <Action>(MoveLineDown)",
          "nmap <A-k> <Action>(MoveLineUp)",
          "vmap <A-j> <Action>(MoveLineDown)",
          "vmap <A-k> <Action>(MoveLineUp)"
        ]
      }
    },
    {
      "category": [
        "ideavim",
        "navigation"
      ],
      "summary": "Find all usages gr",
      "details": [
        "Lists every call site, jump to any",
        "Overrides gr ReplaceWithRegister"
      ],
      "config": {
        "name": "Map find usages",
        "lines": [
          "nmap gr <Action>(FindUsages)"
        ]
      }
    },
    {
      "category": [
        "ideavim",
        "navigation"
      ],
      "summary": "Jump to implementation gi",
      "details": [
        "From an interface to its class",
        "Overrides gi insert-at-last-edit"
      ],
      "config": {
        "name": "Map implementation",
        "lines": [
          "nmap gi <Action>(GotoImplementation)"
        ]
      }
    },
    {
      "category": [
        "ideavim",
        "navigation"
      ],
      "summary": "Map gD to type declaration",
      "details": [
        "By default gD just repeats gd",
        "Jumps from a variable to its type"
      ],
      "config": {
        "name": "Map type declaration",
        "lines": [
          "nmap gD <Action>(GotoTypeDeclaration)"
        ]
      }
    },
    {
      "category": [
        "ideavim",
        "navigation"
      ],
      "summary": "Outline this file gO",
      "details": [
        "Pops up every method and field",
        "Type to filter, Enter to jump there"
      ],
      "config": {
        "name": "Map file structure",
        "lines": [
          "nmap gO <Action>(FileStructurePopup)"
        ]
      }
    },
    {
      "category": [
        "ideavim",
        "cmdline"
      ],
      "summary": "Jump to the test file :A",
      "details": [
        ":A flips between code and its test",
        "No test? It offers to create one"
      ],
      "config": {
        "name": "Add :A for tests",
        "lines": [
          "command! A action GotoTest"
        ]
      }
    },
    {
      "category": [
        "ideavim",
        "windows"
      ],
      "summary": "Flip split orientation Ctrl-w O",
      "details": [
        "Swaps side-by-side for top/bottom",
        "IdeaVim binds no key for this"
      ],
      "config": {
        "name": "Map split orientation",
        "lines": [
          "nmap <C-w>O <Action>(ChangeSplitOrientation)"
        ]
      }
    },
    {
      "category": [
        "ideavim",
        "windows"
      ],
      "summary": "Move a file across splits Ctrl-w m",
      "details": [
        "Moves this tab to the other split",
        "Fixes opening it in the wrong split"
      ],
      "config": {
        "name": "Map cross-split move",
        "lines": [
          "nmap <C-w>m <Action>(MoveEditorToOppositeTabGroup)"
        ]
      }
    }
  ]
}
