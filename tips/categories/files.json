{
  "tips": [
    {
      "category": [
        "files",
        "cmdline"
      ],
      "summary": "Edit another file with :edit {file}",
      "details": [
        ":e %:h/, press Tab to see files",
        "%:h is this file's folder",
        "Bare :e opens the Open File dialog"
      ]
    },
    {
      "category": [
        "files",
        "cmdline"
      ],
      "summary": "Open a file by name :find {file}",
      "details": [
        "Searches the project, not 'path'",
        "Bare :find triggers Go to File"
      ]
    },
    {
      "category": [
        "files",
        "cmdline"
      ],
      "summary": "List open buffers with :ls",
      "details": [
        ":ls numbers every open file",
        ":b 3 then jumps to file number 3"
      ]
    },
    {
      "category": [
        "files"
      ],
      "summary": "Toggle last file Ctrl-^",
      "details": [
        "Back to the file you just left",
        "Ctrl-^ is Ctrl-6 on many keyboards"
      ]
    },
    {
      "category": [
        "files",
        "cmdline"
      ],
      "summary": "Next/previous buffer :bn / :bp",
      "details": [
        ":bn goes to the next buffer",
        ":bp goes to the previous buffer"
      ]
    },
    {
      "category": [
        "files",
        "ideavim"
      ],
      "summary": "Save every open file with :w",
      "details": [
        ":w saves all open files by default",
        "Fires IDE save hooks like reformat",
        ":set ideawrite=file saves just one"
      ]
    },
    {
      "category": [
        "files",
        "cmdline"
      ],
      "summary": "Save a copy with :w {file}",
      "details": [
        ":w bak.kt writes a copy as bak.kt",
        "You keep editing the original",
        ":w! overwrites a file that exists"
      ]
    },
    {
      "category": [
        "files",
        "cmdline"
      ],
      "summary": "Save all files :wa",
      "details": [
        ":wa runs the IDE's Save All",
        ":w does too, unless ideawrite=file"
      ]
    },
    {
      "category": [
        "files",
        "cmdline"
      ],
      "summary": "Insert a file with :read {file}",
      "details": [
        ":r ~/a.txt drops it below this line",
        "Use ~/ or a full path, not a name"
      ]
    },
    {
      "category": [
        "files",
        "cmdline"
      ],
      "summary": "Close this editor tab :q",
      "details": [
        ":q!, ZQ and :bd do the same",
        "Edits are kept, nothing discarded"
      ]
    },
    {
      "category": [
        "files",
        "cmdline"
      ],
      "summary": "Save and close a file ZZ",
      "details": [
        "Closes only the tab, not the IDE",
        ":wq and :x do exactly the same"
      ]
    },
    {
      "category": [
        "files",
        "cmdline"
      ],
      "summary": "Quit every editor with :qa",
      "details": [
        ":qa!, :wqa and :xa do the same",
        "The IDE stays open, edits kept"
      ]
    }
  ]
}
