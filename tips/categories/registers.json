{
  "tips": [
    {
      "category": [
        "registers"
      ],
      "summary": "Yank inner/around word yiw / yaw",
      "details": [
        "yiw copies just the word",
        "yaw takes the trailing space too"
      ]
    },
    {
      "category": [
        "registers"
      ],
      "summary": "Yank whole line yy",
      "details": [
        "yy yanks the current line",
        "5yy yanks five lines",
        "Y does the same as yy"
      ]
    },
    {
      "category": [
        "registers"
      ],
      "summary": "Yank line parts y0 / y$",
      "details": [
        "y0 yanks to start of line",
        "y$ yanks to end of line"
      ]
    },
    {
      "category": [
        "registers"
      ],
      "summary": "Paste after/before p / P",
      "details": [
        "p pastes after, or below for lines",
        "P pastes before, or above for lines"
      ]
    },
    {
      "category": [
        "registers"
      ],
      "summary": "Paste and move past it gp / gP",
      "details": [
        "Cursor lands just past the paste",
        "gP does it for paste-before"
      ]
    },
    {
      "category": [
        "registers"
      ],
      "summary": "Use the yank register \"0",
      "details": [
        "Yank text, then delete something",
        "p now pastes the delete instead",
        "\"0p still pastes what you yanked"
      ]
    },
    {
      "category": [
        "registers"
      ],
      "summary": "Recover the last delete with \"1",
      "details": [
        "Deleted lines queue up in \"1 to \"9",
        "\"1p still works after a new yank"
      ],
      "advanced": true
    },
    {
      "category": [
        "registers"
      ],
      "summary": "Delete without clobbering yanks \"_",
      "details": [
        "\"_dd deletes to the black hole",
        "p still pastes your earlier yank"
      ],
      "advanced": true
    },
    {
      "category": [
        "registers"
      ],
      "summary": "Paste keeping indent ]p / [p",
      "details": [
        "]p pastes below without reindenting",
        "[p pastes above without reindenting"
      ]
    },
    {
      "category": [
        "registers",
        "cmdline"
      ],
      "summary": "Send a yank to top or end :put",
      "details": [
        ":0put pastes your yank at the top",
        ":$put pastes it at the bottom"
      ],
      "advanced": true
    },
    {
      "category": [
        "registers"
      ],
      "summary": "Yank into register a \"ayy",
      "details": [
        "\"ayy yanks the line into a",
        "\"ap pastes it back later",
        "\"Ayy (capital) appends to a"
      ]
    },
    {
      "category": [
        "registers",
        "cmdline"
      ],
      "summary": "Inspect registers with :reg",
      "details": [
        ":reg lists registers and macros",
        "Check what you yanked or recorded"
      ]
    },
    {
      "category": [
        "registers"
      ],
      "summary": "Copy to the OS clipboard \"+yy",
      "details": [
        "Paste it into any other app",
        "\"+p pastes what another app copied"
      ]
    }
  ]
}
